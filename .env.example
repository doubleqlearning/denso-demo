# Benchmark data generation / LLM judge (benchmark/llm_client.py), OpenAI-compatible
MODELARK_BASEURL=
MODELARK_APIKEY=
MODELARK_MODELNAME=

# ModelArk bulk options (both need a ModelArk platform API key, not a Coding Plan key):
# - Online inference (Flex): EXTRACTION_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
#   and EXTRACTION_SERVICE_TIER=flex
# - Batch Chat (deprecated): EXTRACTION_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3/batch
#   and EXTRACTION_MODEL=<batch inference endpoint ID>
# Queued requests can wait a long time: raise EXTRACTION_TIMEOUT_SECONDS (e.g. 86400).
EXTRACTION_API_KEY=
EXTRACTION_MODEL=
EXTRACTION_BASE_URL=
EXTRACTION_SERVICE_TIER=
EXTRACTION_TIMEOUT_SECONDS=
# ModelArk/DeepSeek: disabled saves reasoning tokens for direct extraction.
# Leave blank for other providers; enabled restores reasoning.
EXTRACTION_THINKING=

# Optional LLM faithfulness judge for `kb ingest --verify llm`; ideally another
# model family than extraction. Same keys as EXTRACTION_* (blank = OPENROUTER_*).
VERIFY_API_KEY=
VERIFY_MODEL=
VERIFY_BASE_URL=
VERIFY_THINKING=
# Consolidation of new knowledge with stored lessons during `kb ingest`
# (disable with --no-consolidate). Same keys as EXTRACTION_*.
CONSOLIDATION_API_KEY=
CONSOLIDATION_MODEL=
CONSOLIDATION_BASE_URL=
CONSOLIDATION_THINKING=
# Answer model of the industrial_qa benchmark runner. Same keys as EXTRACTION_*.
ANSWER_API_KEY=
ANSWER_MODEL=
ANSWER_BASE_URL=
ANSWER_THINKING=

# PostgreSQL + pgvector server (see deployments/docker-compose.yml). Each knowledge
# base is stored in its own database kb_<name> on this server, created on first
# use; the database in this URL is only used to create and drop those.
DATABASE_URL=postgresql+psycopg://voice_agent:voice_agent@localhost:5434/voice_agent

# OpenAI-compatible embedding API
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
# Optional for local servers such as text-embeddings-inference (TEI), e.g.
# EMBEDDING_BASE_URL=http://localhost:8080/v1 with no EMBEDDING_API_KEY.
# Max inputs per request (TEI: max_client_batch_size from GET /info).
EMBEDDING_BATCH_SIZE=
# Query instructions live in backend/knowledge_bases/<kb>/embedding_query.md.
# Must match the model's output size; after changing the model run
# `python -m backend.scripts.kb reembed <kb>` for each knowledge base.
EMBEDDING_DIM=
# Set to true only if the provider accepts the `dimensions` request parameter.
EMBEDDING_SEND_DIMENSIONS=false

# Cosine similarity (0..1) at which a vector hit counts as confident. It only
# labels hits: when nothing clears it, the nearest records are still returned
# as low_confidence. Calibrate per embedding model: ~0.3 for
# llama-nemotron-embed-vl-1b-v2, ~0.6 for harrier-oss-v1-0.6b with an instruction.
KNOWLEDGE_MIN_VECTOR_SIMILARITY=0.3

# Industrial QA extracted-knowledge snapshots on Hugging Face.
# HF_TOKEN needs write access for push; public datasets can be pulled without it.
HF_TOKEN=
HF_DATASET_REPO_ID=duonganh2973/industrial_qa
